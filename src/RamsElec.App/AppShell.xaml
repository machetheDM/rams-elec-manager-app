<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RamsElec.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:RamsElec.App.Views"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate views:DashboardPage}" />

        <ShellContent
            Title="Jobs"
            ContentTemplate="{DataTemplate views:JobsPage}" />

        <ShellContent
            Title="Quotes"
            ContentTemplate="{DataTemplate views:QuoteListPage}" />

        <ShellContent
            Title="Invoices"
            ContentTemplate="{DataTemplate views:InvoiceListPage}" />

        <ShellContent
            Title="Payments"
            ContentTemplate="{DataTemplate views:PaymentsPage}" />

        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>

</Shell>
