<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RamsElec.App.ViewModels"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    x:Class="RamsElec.App.Views.AnalyticsPage"
    x:DataType="vm:AnalyticsViewModel"
    Title="Analytics"
    BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15">

            <Label Text="Analytics" FontSize="24" FontAttributes="Bold" TextColor="#1B2A4A" />

            <Frame BackgroundColor="White" CornerRadius="8" Padding="10" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Revenue by Month" FontSize="16" FontAttributes="Bold" TextColor="#1B2A4A" />
                    <lvc:CartesianChart Series="{Binding RevenueSeries}" XAxes="{Binding RevenueXAxes}" YAxes="{Binding RevenueYAxes}" HeightRequest="280" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="White" CornerRadius="8" Padding="10" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Jobs by Status" FontSize="16" FontAttributes="Bold" TextColor="#1B2A4A" />
                    <lvc:PieChart Series="{Binding JobsByStatusSeries}" HeightRequest="280" />
                </VerticalStackLayout>
            </Frame>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#1B2A4A" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
