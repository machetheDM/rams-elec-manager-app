<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RamsElec.App.ViewModels"
    xmlns:models="clr-namespace:RamsElec.Shared.DTOs;assembly=RamsElec.Shared"
    x:Class="RamsElec.App.Views.QuoteListPage"
    x:DataType="vm:QuoteListViewModel"
    Title="Quotes"
    BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*" Padding="15" RowSpacing="10">
        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Quotes" FontSize="24" FontAttributes="Bold" TextColor="#1B2A4A" VerticalOptions="Center" />
            <Button Text="+ New Quote" Command="{Binding NavigateToCreateCommand}" BackgroundColor="#FFC107" TextColor="#1B2A4A" FontAttributes="Bold" CornerRadius="8" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Quotes}" EmptyView="No quotes yet.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:QuoteDto">
                    <Frame Margin="0,5" Padding="12" CornerRadius="8" BackgroundColor="White" HasShadow="True">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:QuoteListViewModel}}, Path=OpenQuoteCommand}" CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding QuoteNumber}" FontSize="16" FontAttributes="Bold" TextColor="#1B2A4A" />
                                <Label Text="{Binding CustomerName}" FontSize="13" TextColor="#666" />
                                <Label Text="{Binding Status}" FontSize="11" TextColor="#999" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Total, StringFormat='R{0:N2}'}" FontAttributes="Bold" FontSize="14" TextColor="#1B2A4A" VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#1B2A4A" />
    </Grid>

</ContentPage>
