<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RamsElec.App.ViewModels"
    x:Class="RamsElec.App.Views.QuoteDetailPage"
    x:DataType="vm:QuoteDetailViewModel"
    Title="Quote Details"
    BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15">
            <Label Text="Quote Details" FontSize="24" FontAttributes="Bold" TextColor="#1B2A4A" />

            <Frame BackgroundColor="White" CornerRadius="8" Padding="15" HasShadow="True" IsVisible="{Binding Quote, Converter={StaticResource ObjectToBoolConverter}}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Quote.QuoteNumber}" FontSize="20" FontAttributes="Bold" TextColor="#1B2A4A" />
                    <Label Text="{Binding Quote.CustomerName}" FontSize="14" />
                    <Label Text="{Binding Quote.Status}" FontSize="13" TextColor="#999" />
                    <Label Text="{Binding Quote.Total, StringFormat='Total: R{0:N2}'}" FontAttributes="Bold" />
                    <Label Text="{Binding Quote.PaymentReference, StringFormat='Payment Ref: {0}'}" IsVisible="{Binding Quote.PaymentReference, Converter={StaticResource StringToBoolConverter}}" TextColor="#2E7D32" />
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding Quote, Converter={StaticResource ObjectToBoolConverter}}">
                <Button Grid.Column="0" Text="Approve" Command="{Binding ApproveCommand}" BackgroundColor="#2E7D32" TextColor="White" FontAttributes="Bold" CornerRadius="8" />
                <Button Grid.Column="1" Text="Reject" Command="{Binding RejectCommand}" BackgroundColor="#C62828" TextColor="White" FontAttributes="Bold" CornerRadius="8" />
            </Grid>

            <Button Text="Convert to Invoice" Command="{Binding ConvertToInvoiceCommand}" BackgroundColor="#1B2A4A" TextColor="White" FontAttributes="Bold" HeightRequest="50" CornerRadius="8" />
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#1B2A4A" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
