<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RamsElec.App.ViewModels"
    x:Class="RamsElec.App.Views.InvoiceListPage"
    x:DataType="vm:InvoiceListViewModel"
    Title="Invoices"
    BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*" Padding="15" RowSpacing="10">
        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Invoices" FontSize="24" FontAttributes="Bold" TextColor="#1B2A4A" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
            <Button Text="+ New Invoice" Command="{Binding NavigateToCreateCommand}" BackgroundColor="#FFC107" TextColor="#1B2A4A" FontAttributes="Bold" CornerRadius="8" />
        </HorizontalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Invoices}" EmptyView="No invoices yet. Tap '+ New Invoice' to create one.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:InvoiceListViewModel">
                    <!-- Placeholder template — will be refined in Phase 2 -->
                    <Frame Margin="0,5" Padding="12" CornerRadius="8" BackgroundColor="White" HasShadow="True">
                        <Label Text="Invoice" FontSize="14" TextColor="#333" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#1B2A4A" />
    </Grid>
</ContentPage>
