<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RamsElec.App.ViewModels"
    xmlns:dtos="clr-namespace:RamsElec.Shared.DTOs;assembly=RamsElec.Shared"
    x:Class="RamsElec.App.Views.InvoiceListPage"
    x:DataType="vm:InvoiceListViewModel"
    Title="Invoices"
    BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*" Padding="15" RowSpacing="10">
        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Invoices" FontSize="24" FontAttributes="Bold" TextColor="#1B2A4A" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
            <Button Text="+ New Invoice" Command="{Binding NavigateToCreateCommand}" BackgroundColor="#FFC107" TextColor="#1B2A4A" FontAttributes="Bold" CornerRadius="8" />
        </HorizontalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Invoices}" EmptyView="No invoices yet. Tap '+ New Invoice' to create one.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dtos:InvoiceDto">
                    <Frame Margin="0,5" Padding="12" CornerRadius="8" BackgroundColor="White" HasShadow="True">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InvoiceListViewModel}}, Path=NavigateToDetailCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{Binding InvoiceNumber}" FontAttributes="Bold" TextColor="#1B2A4A" />
                            <Label Grid.Column="1" Text="{Binding CustomerName}" TextColor="#666" />
                            <Label Grid.Column="2" Text="{Binding Total, StringFormat='R{0:N2}'}" TextColor="#1B2A4A" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#1B2A4A" />
    </Grid>
</ContentPage>
