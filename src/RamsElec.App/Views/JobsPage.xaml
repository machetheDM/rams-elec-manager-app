<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RamsElec.App.ViewModels"
    xmlns:models="clr-namespace:RamsElec.Shared.Models;assembly=RamsElec.Shared"
    x:Class="RamsElec.App.Views.JobsPage"
    x:DataType="vm:JobsViewModel"
    Title="Jobs"
    BackgroundColor="#F5F5F5">
    <Grid RowDefinitions="Auto,*" Padding="15" RowSpacing="10">
        <Label Grid.Row="0" Text="Jobs" FontSize="24" FontAttributes="Bold" TextColor="#1B2A4A" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding Jobs}" EmptyView="No jobs found. Sync to pull jobs from the platform.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Job">
                    <Frame Margin="0,5" Padding="12" CornerRadius="8" BackgroundColor="White" HasShadow="True">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="#1B2A4A" />
                            <Label Text="{Binding Description}" FontSize="13" TextColor="#666" LineBreakMode="TailTruncation" MaxLines="2" />
                            <HorizontalStackLayout Spacing="10">
                                <Frame Padding="4,2" CornerRadius="4" BackgroundColor="#E3F2FD" HasShadow="False"><Label Text="{Binding Status}" FontSize="11" TextColor="#1565C0" /></Frame>
                                <Label Text="{Binding ServiceType}" FontSize="12" TextColor="#999" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#1B2A4A" />
    </Grid>
</ContentPage>
