<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RamsElec.App.ViewModels"
    x:Class="RamsElec.App.Views.SettingsPage"
    x:DataType="vm:SettingsViewModel"
    Title="Settings"
    BackgroundColor="#F5F5F5">
    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15">
            <Label Text="Settings" FontSize="24" FontAttributes="Bold" TextColor="#1B2A4A" />
            <Frame BackgroundColor="White" CornerRadius="8" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Account" FontAttributes="Bold" FontSize="16" TextColor="#1B2A4A" />
                    <HorizontalStackLayout Spacing="8"><Label Text="Name:" TextColor="#666" /><Label Text="{Binding DisplayName}" FontAttributes="Bold" /></HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8"><Label Text="Role:" TextColor="#666" /><Label Text="{Binding Role}" FontAttributes="Bold" /></HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>
            <Frame BackgroundColor="White" CornerRadius="8" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="About" FontAttributes="Bold" FontSize="16" TextColor="#1B2A4A" />
                    <Label Text="Rams @Elec Manager App" TextColor="#666" />
                    <HorizontalStackLayout Spacing="8"><Label Text="Version:" TextColor="#666" /><Label Text="{Binding AppVersion}" /></HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>
            <Button Text="Company Settings"
                    Command="{Binding GoToCompanySettingsCommand}"
                    BackgroundColor="#1B2A4A"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="8" />
            <Button Text="Sign Out" Command="{Binding LogoutCommand}" BackgroundColor="#C62828" TextColor="White" FontAttributes="Bold" HeightRequest="50" CornerRadius="8" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
